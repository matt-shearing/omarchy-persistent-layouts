#!/usr/bin/env python3
"""Save, apply, and autodetect Hyprland display layouts.

A profile is chosen by the *set* of connected displays, not by any single
display's identity. That matters because two physically different panels can
report the same EDID: a cheap portable behind a generic scaler chip can be
indistinguishable from the TV whose EDID it apes. Identity alone cannot tell
those apart, so the connected set decides, and an explicit click always wins
and is remembered for that set.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

CONFIG_DIR = Path.home() / ".config/omarchy/persistent-layouts"
PROFILE_DIR = CONFIG_DIR / "profiles"
LEGACY_PROFILE_DIR = Path.home() / ".config/omarchy/display-profiles"
CONFIG_PATH = CONFIG_DIR / "config.json"

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy" / "persistent-layouts"
LEGACY_STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy"
ACTIVE_PATH = STATE_DIR / "active"
LAST_SET_PATH = STATE_DIR / "last-set"
CHOICE_PATH = STATE_DIR / "choices.json"
ERROR_PATH = STATE_DIR / "last-error"
LEGACY_ACTIVE_PATH = LEGACY_STATE_DIR / "display-profile-active"
LEGACY_LAST_SET_PATH = LEGACY_STATE_DIR / "display-profile-last-set"

HYPRMON = Path.home() / ".config/hypr/hyprmon.lua"

OUTPUT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$")
MODE_RE = re.compile(r"^(preferred|\d{3,5}x\d{3,5}@\d{1,4}(?:\.\d{1,3})?)$")
POS_RE = re.compile(r"^(auto|-?\d{1,6}x-?\d{1,6})$")

# How long to let Hyprland settle before reading back what actually applied.
SETTLE_SECONDS = 0.6

# hyprctl can block forever on a wedged DRM commit (Framework HDMI after a
# long s2idle). Bound every compositor call so auto-apply can retry later.
HYPRCTL_TIMEOUT = ["timeout", "--kill-after=1s", "5s"]


def hyprctl(args: list[str], capture: bool = False) -> str:
    cmd = HYPRCTL_TIMEOUT + ["hyprctl", *args]
    try:
        if capture:
            return subprocess.check_output(cmd, text=True)
        subprocess.check_call(cmd, stdout=subprocess.DEVNULL)
        return ""
    except subprocess.CalledProcessError as exc:
        raise SystemExit(f"hyprctl timed out or failed: {' '.join(args)}") from exc


def run_json(cmd: list[str]) -> object:
    out = subprocess.check_output(cmd, text=True)
    return json.loads(out)


def hypr_monitors() -> list[dict]:
    """Live connectors, including disabled ones, with dummy EDIDs recovered.

    `hyprctl -j monitors` omits disabled heads, so a dummy-masked Arzopa would
    vanish from matching and never get a 1080p modeset. `monitors all` plus an
    I2C EDID overlay is what lets the saved desk win after s2idle.
    """
    try:
        raw = hyprctl(["-j", "monitors", "all"], capture=True)
    except SystemExit:
        raw = hyprctl(["-j", "monitors"], capture=True)
    return [recover_dummy_identity(m) for m in json.loads(raw)]


# --------------------------------------------------------------------------
# Identity
# --------------------------------------------------------------------------

def is_dummy_monitor(mon: dict) -> bool:
    """True for amdgpu/vkms dummy EDIDs, not a real panel.

    After s2idle those connectors often come back as connected 0x0 outputs
    named "The Linux Foundation Linux FHD". Hyprland then modesets them,
    they steal CRTCs from the laptop panel, and the connected-set no longer
    matches laptop-only (or any saved desk).
    """
    make = str(mon.get("make") or "").strip()
    model = str(mon.get("model") or "").strip()
    desc = str(mon.get("description") or "").strip()
    if make == "The Linux Foundation" and "Linux FHD" in model:
        return True
    return desc.startswith("The Linux Foundation Linux FHD")


def real_monitors(mons: list[dict]) -> list[dict]:
    return [m for m in mons if not is_dummy_monitor(m)]


# PNP three-letter codes vs the make Hyprland uses for the same panel.
PNP_MAKE = {
    "GWD": "GWD",
    "ESP": "ESP",
    "GSM": "LG Electronics",
    "BOE": "BOE",
    "LNX": "The Linux Foundation",
}

I2C_SLAVE = 0x0703
_EDID_CACHE: dict[str, dict | None] = {}


def parse_edid(data: bytes) -> dict | None:
    """Make/model/serial from a 128-byte EDID block. None if the blob is junk."""
    if not data or len(data) < 128:
        return None
    if data[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
        return None
    mfg = (data[8] << 8) | data[9]

    def letter(v: int) -> str:
        v = v & 0x1F
        return chr(v + 64) if 1 <= v <= 26 else "?"

    pnp = letter(mfg >> 10) + letter(mfg >> 5) + letter(mfg)
    make = PNP_MAKE.get(pnp, pnp)
    name = ""
    serial_str = ""
    for i in range(4):
        d = data[54 + i * 18 : 72 + i * 18]
        if len(d) < 18:
            break
        if d[0] == 0 and d[1] == 0 and d[3] == 0xFC:
            name = d[5:].split(b"\n")[0].decode("ascii", "replace").strip()
        if d[0] == 0 and d[1] == 0 and d[3] == 0xFF:
            serial_str = d[5:].split(b"\n")[0].decode("ascii", "replace").strip()
    raw_serial = data[12] | (data[13] << 8) | (data[14] << 16) | (data[15] << 24)
    model = name or pnp
    serial = serial_str or (f"0x{raw_serial:08x}" if raw_serial else "")
    desc = f"{make} {model}".strip()
    if serial:
        desc = f"{desc} {serial}"
    return {"make": make, "model": model, "serial": serial, "description": desc, "pnp": pnp}


def i2c_dev_nodes(output: str) -> list[Path]:
    if not OUTPUT_RE.fullmatch(output or ""):
        return []
    drm = Path("/sys/class/drm")
    nodes: list[Path] = []
    seen: set[str] = set()
    for conn in sorted(drm.glob(f"card*-{output}")):
        candidates = []
        ddc = conn / "ddc"
        if ddc.exists():
            candidates.append(ddc)
        candidates.extend(sorted(conn.glob("i2c-*")))
        for child in candidates:
            try:
                name = child.resolve().name if child.is_symlink() else child.name
            except OSError:
                name = child.name
            if not name.startswith("i2c-"):
                continue
            dev = Path("/dev") / name
            key = str(dev)
            if dev.exists() and key not in seen:
                seen.add(key)
                nodes.append(dev)
    return nodes


def read_i2c_edid(dev: Path) -> bytes | None:
    try:
        fd = os.open(dev, os.O_RDWR)
    except OSError:
        return None
    try:
        fcntl.ioctl(fd, I2C_SLAVE, 0x50)
        os.write(fd, b"\x00")
        time.sleep(0.02)
        data = os.read(fd, 128)
    except OSError:
        return None
    finally:
        try:
            os.close(fd)
        except OSError:
            pass
    return data if data else None


def read_output_edid(output: str) -> dict | None:
    """First non-dummy EDID on the connector's I2C/DDC buses."""
    if output in _EDID_CACHE:
        return _EDID_CACHE[output]
    parsed = None
    for dev in i2c_dev_nodes(output):
        blob = read_i2c_edid(dev)
        if not blob:
            continue
        got = parse_edid(blob)
        if not got:
            continue
        if got.get("pnp") == "LNX" or "Linux FHD" in str(got.get("model") or ""):
            continue
        parsed = got
        break
    _EDID_CACHE[output] = parsed
    return parsed


def recover_dummy_identity(mon: dict, reader=None) -> dict:
    """If Hyprland has Linux FHD but I2C has a real panel, use the real identity.

    After s2idle amdgpu often fails the connector EDID (`EDID err: 2`) and
    leaves a dummy sink. Persistent Layouts then disables it so it cannot steal
    a CRTC — and the Arzopa, which is on the wire, stays dark. The panel still
    answers on the AUX/I2C bus. Overlay that identity so the 1080p desk matches
    and the dummy is not disabled.
    """
    if not is_dummy_monitor(mon):
        return mon
    name = str(mon.get("name") or "")
    parsed = (reader or read_output_edid)(name)
    if not parsed:
        return mon
    model = str(parsed.get("model") or "")
    make = str(parsed.get("make") or "")
    if make == "The Linux Foundation" or "Linux FHD" in model:
        return mon
    known = model in {"ARZOPA", "LG TV SSCR2", "eD15(2024)"} or make in {
        "GWD",
        "ESP",
        "LG Electronics",
    }
    if not known:
        return mon
    out = dict(mon)
    out["_recovered_from_dummy"] = True
    out["make"] = parsed["make"]
    out["model"] = parsed["model"]
    out["serial"] = parsed.get("serial") or ""
    out["description"] = parsed["description"]
    return out


def fingerprint(mon: dict) -> str:
    """Stable identity for a live monitor. Deliberately excludes the connector
    name, which renumbers, and the serial, which some panels fake."""
    make = str(mon.get("make") or "").strip()
    model = str(mon.get("model") or "").strip()
    if make and model:
        return f"{make}|{model}"
    desc = str(mon.get("description") or "").strip()
    if desc:
        return desc
    return str(mon.get("name") or "").strip()


def match_fingerprint(match: dict) -> str:
    make = str(match.get("make") or "").strip()
    model = str(match.get("model") or "").strip()
    if make and model:
        return f"{make}|{model}"
    desc = str(match.get("description") or "").strip()
    if desc:
        return desc
    return str(match.get("output_hint") or "").strip()


def mon_serial(mon: dict) -> str:
    return str(mon.get("serial") or "").strip()


def connected_set(mons: list[dict]) -> frozenset[str]:
    return frozenset(fingerprint(m) for m in mons if fingerprint(m))


def topology_id(mons: list[dict]) -> str:
    """Key for 'which displays are plugged in', independent of their modes."""
    return "\n".join(sorted(fingerprint(m) for m in mons if fingerprint(m)))


def mode_string(mon: dict) -> str:
    w, h = int(mon["width"]), int(mon["height"])
    rr = float(mon.get("refreshRate") or 0)
    if abs(rr - round(rr)) < 0.02:
        return f"{w}x{h}@{int(round(rr))}.00"
    return f"{w}x{h}@{rr:.2f}"


def slugify(name: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    return s or "layout"


def mode_dims_from_string(mode: str) -> str:
    m = re.match(r"(\d+)x(\d+)", str(mode or ""))
    return f"{m.group(1)}x{m.group(2)}" if m else ""


def mode_dims(mon: dict) -> str:
    try:
        return f"{int(mon['width'])}x{int(mon['height'])}"
    except (KeyError, TypeError, ValueError):
        return mode_dims_from_string(mode_string(mon))


def spec_dims(spec: dict) -> str:
    return mode_dims_from_string(str(spec.get("mode") or ""))


def placeholder_serial(serial: str) -> bool:
    """Generic scaler chips ship placeholder serials like 0x01010101."""
    s = serial.lower().removeprefix("0x")
    return bool(s) and len(set(s)) <= 2 and s in {"0" * len(s), "01" * (len(s) // 2)}


def auto_label(mon: dict) -> str:
    """Human-facing name. Always carries the resolution, so two panels that
    report the same make/model are still tellable apart in the UI."""
    name = str(mon.get("model") or "").strip() or str(mon.get("description") or "").strip()
    name = name or str(mon.get("name") or "display")
    label = f"{name} · {mode_dims(mon)}"
    if placeholder_serial(mon_serial(mon)):
        label += " · unverified EDID"
    return label


# --------------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------------

def ensure_layout_dirs() -> None:
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not any(PROFILE_DIR.glob("*.json")) and LEGACY_PROFILE_DIR.is_dir():
        for path in LEGACY_PROFILE_DIR.glob("*.json"):
            dest = PROFILE_DIR / path.name
            if not dest.exists():
                shutil.copy2(path, dest)
    if not ACTIVE_PATH.exists() and LEGACY_ACTIVE_PATH.exists():
        ACTIVE_PATH.write_text(LEGACY_ACTIVE_PATH.read_text())
    if not LAST_SET_PATH.exists() and LEGACY_LAST_SET_PATH.exists():
        LAST_SET_PATH.write_text(LEGACY_LAST_SET_PATH.read_text())


def default_config() -> dict:
    return {"auto": True}


def load_config() -> dict:
    ensure_layout_dirs()
    data = default_config()
    try:
        raw = json.loads(CONFIG_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return data
    if isinstance(raw, dict):
        data["auto"] = raw.get("auto") is not False
    return data


def write_config(cfg: dict) -> None:
    ensure_layout_dirs()
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps({"auto": bool(cfg.get("auto", True))}, indent=2) + "\n")


def auto_enabled() -> bool:
    return load_config().get("auto") is not False


def load_profiles() -> list[dict]:
    ensure_layout_dirs()
    profiles = []
    for path in sorted(PROFILE_DIR.glob("*.json")):
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict) or not data.get("outputs"):
            continue
        data.setdefault("id", path.stem)
        data["_path"] = str(path)
        profiles.append(data)
    return profiles


def profile_set(profile: dict) -> frozenset[str]:
    return frozenset(
        match_fingerprint(o.get("match") or {})
        for o in profile.get("outputs") or []
        if match_fingerprint(o.get("match") or {})
    )


def profile_topology_id(profile: dict) -> str:
    return "\n".join(
        sorted(
            match_fingerprint(o.get("match") or {})
            for o in profile.get("outputs") or []
            if match_fingerprint(o.get("match") or {})
        )
    )


def write_profile(profile: dict) -> Path:
    ensure_layout_dirs()
    pid = profile["id"]
    path = PROFILE_DIR / f"{pid}.json"
    out = {k: v for k, v in profile.items() if not k.startswith("_")}
    path.write_text(json.dumps(out, indent=2) + "\n")
    return path


def active_id() -> str:
    try:
        return ACTIVE_PATH.read_text().strip()
    except OSError:
        return ""


def last_set() -> list[str]:
    try:
        data = json.loads(LAST_SET_PATH.read_text())
        return [str(x) for x in data] if isinstance(data, list) else []
    except (OSError, json.JSONDecodeError):
        return []


def load_choices() -> dict:
    try:
        data = json.loads(CHOICE_PATH.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def remember_choice(mons: list[dict], pid: str) -> None:
    """An explicit apply pins that profile to this set of displays, so
    auto-apply cannot second-guess the user on the next hotplug."""
    ensure_layout_dirs()
    choices = load_choices()
    choices[topology_id(mons)] = pid
    CHOICE_PATH.write_text(json.dumps(choices, indent=2) + "\n")


def recall_choice(mons: list[dict]) -> str:
    return str(load_choices().get(topology_id(mons)) or "")


def set_error(message: str) -> None:
    ensure_layout_dirs()
    if message:
        ERROR_PATH.write_text(message.strip() + "\n")
    elif ERROR_PATH.exists():
        ERROR_PATH.unlink()


def last_error() -> str:
    try:
        return ERROR_PATH.read_text().strip()
    except OSError:
        return ""


# --------------------------------------------------------------------------
# Matching
# --------------------------------------------------------------------------

def topology_key(mons: list[dict]) -> list[str]:
    return sorted(f"{fingerprint(m)}|{mode_dims(m)}" for m in mons)


def assignment_score(spec: dict, mon: dict) -> int:
    score = 0
    match = spec.get("match") or {}
    want_fp = match_fingerprint(match)
    got_fp = fingerprint(mon)
    if want_fp and got_fp == want_fp:
        score += 100
    want_serial = str(match.get("serial") or "").strip()
    if want_serial and want_serial == mon_serial(mon):
        score += 30
    want_desc = str(match.get("description") or "").strip()
    got_desc = str(mon.get("description") or "")
    if want_desc and want_desc == got_desc:
        score += 20
    want_dims = spec_dims(spec)
    if want_dims and want_dims == mode_dims(mon):
        score += 40
    if str(spec.get("mode") or "") == mode_string(mon):
        score += 10
    hint = str(spec.get("output_hint") or "")
    if hint and mon.get("name") == hint:
        score += 5
    return score


def profile_matches_topology(profile: dict, mons: list[dict]) -> bool:
    """Exact match on the multiset of connected identities.

    Exact, not fuzzy: a 2-display profile must never win while 3 displays are
    plugged in, and a leftover display must never be quietly conscripted to
    fill a saved output it is not.
    """
    want = sorted(
        match_fingerprint(o.get("match") or {}) for o in profile.get("outputs") or []
    )
    got = sorted(fingerprint(m) for m in mons)
    return bool(want) and want == got


def assign_outputs(profile: dict, mons: list[dict]) -> list[tuple[dict, dict]] | None:
    """Map each saved output to exactly one live monitor.

    Only called once the topology already matches, so this is purely about
    which spec goes with which monitor when several share a fingerprint.
    """
    specs = list(profile.get("outputs") or [])
    if not specs or not mons or len(specs) != len(mons):
        return None

    pairs = []
    for si, spec in enumerate(specs):
        for mi, mon in enumerate(mons):
            pairs.append((-assignment_score(spec, mon), si, mi))
    pairs.sort()

    used_s: set[int] = set()
    used_m: set[int] = set()
    mapping: dict[int, dict] = {}
    for _neg, si, mi in pairs:
        if si in used_s or mi in used_m:
            continue
        used_s.add(si)
        used_m.add(mi)
        mapping[si] = mons[mi]
    if len(mapping) != len(specs):
        return None
    return [(specs[i], mapping[i]) for i in range(len(specs))]


def scale_eq(a: object, b: object) -> bool:
    try:
        return abs(float(a) - float(b)) < 0.02
    except (TypeError, ValueError):
        return False


def spec_satisfied(spec: dict, mon: dict) -> bool:
    want_dims = spec_dims(spec)
    if want_dims and want_dims != mode_dims(mon):
        return False
    if not scale_eq(spec.get("scale", 1), mon.get("scale", 1)):
        return False
    want_pos = str(spec.get("position") or "auto")
    if want_pos != "auto":
        if want_pos != f'{int(mon["x"])}x{int(mon["y"])}':
            return False
    return True


def profile_is_applied(profile: dict, mons: list[dict]) -> bool:
    """True when the live layout already equals the profile.

    Compared against real monitor state rather than a remembered token, so a
    stale state file can never cause an apply loop.
    """
    mapping = assign_outputs(profile, mons)
    if not mapping:
        return False
    return all(spec_satisfied(spec, mon) for spec, mon in mapping)


def detect(profiles: list[dict], mons: list[dict]) -> dict | None:
    if not mons:
        return None
    candidates = [
        p for p in profiles
        if profile_matches_topology(p, mons) and assign_outputs(p, mons) is not None
    ]
    if not candidates:
        return None
    if len(candidates) == 1:
        return candidates[0]

    # Several profiles describe this exact set of displays. Prefer what the
    # user last chose for this set, then whatever is already applied, then the
    # active one. Only then fall back to an arbitrary but stable order.
    chosen = recall_choice(mons)
    for p in candidates:
        if p.get("id") == chosen:
            return p
    for p in candidates:
        if profile_is_applied(p, mons):
            return p
    current = active_id()
    for p in candidates:
        if p.get("id") == current:
            return p
    return sorted(candidates, key=lambda p: str(p.get("id") or ""))[0]


def detect_ambiguous(profiles: list[dict], mons: list[dict]) -> list[str]:
    return [
        str(p.get("id") or "")
        for p in profiles
        if profile_matches_topology(p, mons) and assign_outputs(p, mons) is not None
    ]


# --------------------------------------------------------------------------
# Apply
# --------------------------------------------------------------------------

def check_output_name(name: str) -> str:
    if not OUTPUT_RE.fullmatch(name):
        raise SystemExit(f"refusing unsafe output name: {name!r}")
    return name


def check_mode(mode: str) -> str:
    if not MODE_RE.fullmatch(mode):
        raise SystemExit(f"refusing unsafe mode: {mode!r}")
    return mode


def check_position(pos: str) -> str:
    if not POS_RE.fullmatch(pos):
        raise SystemExit(f"refusing unsafe position: {pos!r}")
    return pos


def check_scale(scale: object) -> float:
    try:
        value = float(scale)
    except (TypeError, ValueError):
        raise SystemExit(f"refusing unsafe scale: {scale!r}") from None
    if not 0.1 <= value <= 8.0:
        raise SystemExit(f"refusing unsafe scale: {scale!r}")
    return value


def lua_string(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def disable_dummy_outputs() -> list[str]:
    """Disable dummy DRM sinks so they stop occupying CRTCs.

    Returns the connector names Hyprland was asked to disable. Already-disabled
    dummies are left alone. Failures are swallowed: a wedged modeset must not
    block auto-apply of the real desk.
    """
    try:
        raw = hyprctl(["-j", "monitors", "all"], capture=True)
    except SystemExit:
        try:
            raw = hyprctl(["-j", "monitors"], capture=True)
        except SystemExit:
            return []
    try:
        mons = list(json.loads(raw))
    except json.JSONDecodeError:
        return []
    names: list[str] = []
    for mon in mons:
        mon = recover_dummy_identity(mon)
        if not is_dummy_monitor(mon) or mon.get("disabled"):
            continue
        name = str(mon.get("name") or "")
        if not OUTPUT_RE.fullmatch(name):
            continue
        try:
            hyprctl(
                [
                    "eval",
                    "hl.monitor({ output = %s, disabled = true })"
                    % lua_string(name),
                ]
            )
        except SystemExit:
            continue
        names.append(name)
    return names


def apply_monitor(
    name: str, mode: str, pos: str, scale: float, recovered: bool = False
) -> None:
    if recovered:
        # monitors.lua's last matching rule disables Linux FHD. A connector
        # name eval is ignored until that desc rule is cleared.
        hyprctl(
            [
                "eval",
                'hl.monitor({ output = "desc:The Linux Foundation Linux FHD", disabled = false })',
            ]
        )
    expr = (
        "hl.monitor({ output = %s, mode = %s, position = %s, scale = %.2f, disabled = false })"
        % (lua_string(name), lua_string(mode), lua_string(pos), scale)
    )
    hyprctl(["eval", expr])


def apply_profile(profile: dict) -> list[str]:
    """Apply a profile and report, per output, anything that did not take.

    Returns a list of human-readable problems; empty means everything landed.
    Hyprland accepting a modeset does not prove the panel lit up, so this only
    claims what it can actually verify: that the compositor is now driving the
    geometry the profile asked for.
    """
    mons = real_monitors(hypr_monitors())
    mapping = assign_outputs(profile, mons)
    if not mapping:
        raise SystemExit("could not match saved outputs to the connected screens")

    disable_dummy_outputs()

    def apply_rank(item: tuple[dict, dict]) -> int:
        name = str(item[1].get("name") or "")
        if name.startswith("eDP"):
            return 0
        if item[1].get("_recovered_from_dummy"):
            return 2
        return 1

    mapping = sorted(mapping, key=apply_rank)

    applied = []
    for spec, mon in mapping:
        name = check_output_name(str(mon["name"]))
        mode = check_mode(str(spec.get("mode") or "preferred"))
        # Dummy-masked Arzopa still advertises whatever the scaler likes.
        # Never take "preferred" on a recovered sink — that is how 4K blanks it.
        if mon.get("_recovered_from_dummy") and mode == "preferred":
            mode = "1920x1080@60"
        pos = check_position(str(spec.get("position") or "auto"))
        scale = check_scale(spec.get("scale", 1))
        apply_monitor(name, mode, pos, scale, recovered=bool(mon.get("_recovered_from_dummy")))
        applied.append(
            {"name": name, "mode": mode, "position": pos, "scale": scale, "spec": spec}
        )

    # Clearing the Linux FHD desc rule can re-enable a true dummy on another
    # connector. Kill those again; recovered sinks are no longer dummy.
    disable_dummy_outputs()

    time.sleep(SETTLE_SECONDS)
    after = {m["name"]: m for m in hypr_monitors()}

    problems = []
    for item in applied:
        mon = after.get(item["name"])
        label = str(item["spec"].get("label") or "") or item["name"]
        if mon is None:
            problems.append(f"{label}: output disappeared after apply")
            continue
        if not spec_satisfied(item["spec"], mon):
            problems.append(
                f"{label}: asked for {item['mode']} @{item['scale']:g} {item['position']}, "
                f"got {mode_string(mon)} @{float(mon.get('scale') or 1):g} {int(mon['x'])}x{int(mon['y'])}"
            )

    write_hyprmon([{k: v for k, v in i.items() if k != "spec"} for i in applied])
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    ACTIVE_PATH.write_text(profile["id"] + "\n")
    # Written from post-apply state, so "already applied" checks stay truthful.
    LAST_SET_PATH.write_text(json.dumps(topology_key(list(after.values()))) + "\n")
    set_error("; ".join(problems))
    return problems


def write_hyprmon(applied: list[dict]) -> None:
    # Only refresh HyprMon's generated file. Do not create it for users who
    # do not already use HyprMon, and do not edit monitors.lua.
    if not HYPRMON.exists():
        return
    lines = ["-- Generated by HyprMon. Manual changes may be overwritten.", ""]
    for item in applied:
        mode = item["mode"]
        if re.search(r"@\d+$", mode):
            mode = mode + ".00"
        mode = check_mode(mode)
        lines.append(
            "hl.monitor({ output = %s, mode = %s, position = %s, scale = %.2f })"
            % (
                lua_string(check_output_name(item["name"])),
                lua_string(mode),
                lua_string(check_position(item["position"])),
                check_scale(item["scale"]),
            )
        )
    HYPRMON.write_text("\n".join(lines) + "\n")


# --------------------------------------------------------------------------
# Snapshot
# --------------------------------------------------------------------------

def snapshot(name: str | None = None, pid: str | None = None) -> dict:
    mons = real_monitors(hypr_monitors())
    if not mons:
        raise SystemExit("no monitors from hyprctl")
    if not pid:
        pid = slugify(name or f"{len(mons)}-screen")
    if not name:
        name = pid.replace("-", " ").title()

    # Carry forward any labels the user already curated for this profile.
    prior = {}
    prior_path = PROFILE_DIR / f"{pid}.json"
    try:
        old = json.loads(prior_path.read_text())
        for o in old.get("outputs") or []:
            key = (match_fingerprint(o.get("match") or {}), spec_dims(o))
            if o.get("label"):
                prior[key] = o["label"]
            prior.setdefault((key[0], None), o.get("label"))
    except (OSError, json.JSONDecodeError):
        pass

    outputs = []
    for mon in mons:
        fp = fingerprint(mon)
        label = prior.get((fp, mode_dims(mon))) or prior.get((fp, None)) or auto_label(mon)
        entry = {
            "match": {
                "make": str(mon.get("make") or ""),
                "model": str(mon.get("model") or ""),
                "serial": mon_serial(mon),
                "description": str(mon.get("description") or ""),
            },
            "output_hint": mon["name"],
            "mode": mode_string(mon),
            "scale": float(mon.get("scale") or 1),
            "position": f'{int(mon["x"])}x{int(mon["y"])}',
            "label": label,
        }
        if placeholder_serial(mon_serial(mon)):
            # This panel's advertised mode list cannot be trusted; the saved
            # mode is the only thing known to actually work on it.
            entry["trust_edid_modes"] = False
        outputs.append(entry)

    return {
        "id": pid,
        "name": name,
        "updated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "outputs": outputs,
    }


# --------------------------------------------------------------------------
# Status
# --------------------------------------------------------------------------

def status_payload() -> dict:
    mons = real_monitors(hypr_monitors())
    profiles = load_profiles()
    connected = sorted(fingerprint(m) for m in mons)
    match = detect(profiles, mons)

    # Prefer labels from whichever profile describes this set of displays.
    labels: dict[str, str] = {}
    source = match or next((p for p in profiles if p.get("id") == active_id()), None)
    if source:
        mapping = assign_outputs(source, mons)
        if mapping:
            for spec, mon in mapping:
                if spec.get("label"):
                    labels[str(mon["name"])] = str(spec["label"])

    current = []
    for mon in mons:
        current.append(
            {
                "name": mon.get("name"),
                "fingerprint": fingerprint(mon),
                "description": mon.get("description"),
                "label": labels.get(str(mon.get("name"))) or auto_label(mon),
                "mode": mode_string(mon),
                "resolution": mode_dims(mon),
                "scale": mon.get("scale"),
                "position": f'{int(mon["x"])}x{int(mon["y"])}',
                "suspect_edid": placeholder_serial(mon_serial(mon)),
            }
        )

    listed = []
    for p in profiles:
        matches = profile_matches_topology(p, mons) and assign_outputs(p, mons) is not None
        listed.append(
            {
                "id": p.get("id"),
                "name": p.get("name") or p.get("id"),
                "outputs": len(p.get("outputs") or []),
                "fingerprints": sorted(profile_set(p)),
                "labels": [str(o.get("label") or "") for o in p.get("outputs") or []],
                "matches": matches,
                "applied": profile_is_applied(p, mons),
                "active": p.get("id") == active_id(),
            }
        )

    return {
        "ok": True,
        "connected": connected,
        "current": current,
        "active": active_id(),
        "detected": (match or {}).get("id"),
        "candidates": detect_ambiguous(profiles, mons),
        "profiles": listed,
        "auto": auto_enabled(),
        "error": last_error(),
    }


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

def cmd_save(args: argparse.Namespace) -> int:
    existing = {p["id"]: p for p in load_profiles()}
    name = args.name
    pid = args.id
    if not pid and args.update_matching:
        mons = hypr_monitors()
        match = next(
            (p for p in existing.values() if profile_matches_topology(p, mons)),
            None,
        )
        if match:
            pid = match["id"]
            name = name or match.get("name")
    snap = snapshot(name, pid)
    if snap["id"] in existing and name is None:
        snap["name"] = existing[snap["id"]].get("name") or snap["name"]
    path = write_profile(snap)
    # Keep HyprMon's generated file in step with what was just saved, so the
    # two cannot drift apart until the next apply.
    write_hyprmon(
        [
            {
                "name": o["output_hint"],
                "mode": o["mode"],
                "position": o["position"],
                "scale": o["scale"],
            }
            for o in snap["outputs"]
        ]
    )
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    mons = real_monitors(hypr_monitors())
    ACTIVE_PATH.write_text(snap["id"] + "\n")
    LAST_SET_PATH.write_text(json.dumps(topology_key(mons)) + "\n")
    remember_choice(mons, snap["id"])
    if args.json:
        print(json.dumps({"ok": True, "id": snap["id"], "path": str(path)}, indent=2))
    else:
        print(f"saved {snap['id']} ({len(snap['outputs'])} outputs) -> {path}")
    return 0


def cmd_apply(args: argparse.Namespace) -> int:
    profiles = {p["id"]: p for p in load_profiles()}
    if args.name not in profiles:
        raise SystemExit(f"unknown profile: {args.name}")
    problems = apply_profile(profiles[args.name])
    # An explicit apply is the user's decision; pin it so the next hotplug or
    # auto-apply pass does not overrule it.
    remember_choice(real_monitors(hypr_monitors()), args.name)
    if args.json:
        print(json.dumps({"ok": not problems, "id": args.name, "problems": problems}))
    elif problems:
        print(f"applied {args.name} with problems:", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
    else:
        print(f"applied {args.name}")
    return 1 if problems else 0


def cmd_list(args: argparse.Namespace) -> int:
    payload = status_payload()
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    for p in payload["profiles"]:
        mark = "*" if p["active"] else ("~" if p["matches"] else " ")
        print(f"{mark} {p['id']:24} {p['name']}  ({p['outputs']} outputs)")
    return 0


def cmd_detect(args: argparse.Namespace) -> int:
    mons = real_monitors(hypr_monitors())
    profiles = load_profiles()
    match = detect(profiles, mons)
    connected = sorted(fingerprint(m) for m in mons)
    if args.apply:
        if not auto_enabled():
            if args.json:
                print(json.dumps({"ok": True, "applied": False, "reason": "auto-off", "connected": connected}))
            return 0
        if not match:
            if args.json:
                print(json.dumps({"ok": False, "applied": False, "reason": "no-match", "connected": connected}))
            return 1
        if profile_is_applied(match, mons):
            if args.json:
                print(json.dumps({"ok": True, "applied": False, "id": match["id"], "reason": "already"}))
            return 0
        problems = apply_profile(match)
        if args.json:
            print(json.dumps({"ok": not problems, "applied": True, "id": match["id"], "problems": problems}))
        else:
            print(f"detected {match['id']}")
        return 1 if problems else 0
    if args.json:
        print(json.dumps({"ok": True, "id": (match or {}).get("id"), "connected": connected}))
        return 0 if match else 1
    if not match:
        print("no matching profile")
        return 1
    print(match["id"])
    return 0


def cmd_status(_args: argparse.Namespace) -> int:
    print(json.dumps(status_payload(), indent=2))
    return 0


def cmd_auto(args: argparse.Namespace) -> int:
    cfg = load_config()
    if args.state is None:
        if args.json:
            print(json.dumps({"ok": True, "auto": cfg["auto"]}))
        else:
            print("on" if cfg["auto"] else "off")
        return 0
    cfg["auto"] = args.state in {"on", "true", "1"}
    write_config(cfg)
    if args.json:
        print(json.dumps({"ok": True, "auto": cfg["auto"]}))
    else:
        print("on" if cfg["auto"] else "off")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Save, apply, and autodetect Hyprland display layouts.")
    parser.add_argument("--json", action="store_true")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_save = sub.add_parser("save", help="save the current layout")
    p_save.add_argument("id", nargs="?", help="profile id")
    p_save.add_argument("--id", dest="id_opt", help=argparse.SUPPRESS)
    p_save.add_argument("--name", help="display name")
    p_save.add_argument("--update-matching", action="store_true")
    p_save.add_argument("--json", action="store_true")
    p_save.set_defaults(func=cmd_save)

    p_apply = sub.add_parser("apply", help="apply a saved profile")
    p_apply.add_argument("name")
    p_apply.add_argument("--json", action="store_true")
    p_apply.set_defaults(func=cmd_apply)

    p_list = sub.add_parser("list", help="list profiles")
    p_list.add_argument("--json", action="store_true")
    p_list.set_defaults(func=cmd_list)

    p_detect = sub.add_parser("detect", help="find the profile for the connected set")
    p_detect.add_argument("--apply", action="store_true")
    p_detect.add_argument("--json", action="store_true")
    p_detect.set_defaults(func=cmd_detect)

    p_status = sub.add_parser("status", help="JSON status for the bar applet")
    p_status.add_argument("--json", action="store_true")
    p_status.set_defaults(func=cmd_status)

    p_auto = sub.add_parser("auto", help="show or set auto-apply on plug-in")
    p_auto.add_argument("state", nargs="?", choices=["on", "off", "true", "false", "1", "0"])
    p_auto.add_argument("--json", action="store_true")
    p_auto.set_defaults(func=cmd_auto)

    args = parser.parse_args()
    if getattr(args, "id_opt", None) and not args.id:
        args.id = args.id_opt
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
